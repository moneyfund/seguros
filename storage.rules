rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Acceso únicamente para usuarios autenticados y verificados.
    function verified() {
      return request.auth != null &&
        request.auth.token.email_verified == true;
    }

    // Administradores fundadores de XARCON / empresa de seguros.
    function isOwner() {
      return verified() &&
        request.auth.token.email in [
          'norvingarcia220@gmail.com',
          'amyblandon171@gmail.com'
        ];
    }

    // Lee el rol aprobado en Firestore.
    // Firebase puede solicitar habilitar permisos Storage -> Firestore.
    function isActiveMember() {
      return verified() &&
        firestore.exists(
          /databases/(default)/documents/companies/main/members/$(request.auth.uid)
        ) &&
        firestore.get(
          /databases/(default)/documents/companies/main/members/$(request.auth.uid)
        ).data.active == true;
    }

    function canViewDocuments() {
      return isOwner() || (
        isActiveMember() &&
        firestore.get(/databases/(default)/documents/companies/main/members/$(request.auth.uid))
          .data.get('allowedSections', []).hasAny(['documentos'])
      );
    }

    function supportedDocument() {
      return request.resource != null &&
        request.resource.size > 0 &&
        request.resource.size <= 8 * 1024 * 1024 &&
        request.resource.contentType in [
          'application/pdf',
          'image/jpeg',
          'image/png',
          'image/webp'
        ];
    }

    // Pilot-only fictional attachments. Real identity/policy documents must not be uploaded.
    match /companies/main/pilotDocuments/{ownerUid}/{fileName} {
      allow get: if isOwner();
      allow list: if false;
      allow create: if isOwner() &&
        request.auth.uid == ownerUid &&
        supportedDocument() &&
        fileName.matches('[0-9a-f-]+[.](pdf|jpg|png|webp)');
      allow update: if false;
      allow delete: if isOwner();
    }

    // Applicant files are private. No public downloads or folder listing.
    // Staff identity domain is configured in Firestore after the domain is purchased.
    function institutionalApplicant(uid) {
      return verified() &&
        request.auth.uid == uid &&
        firestore.exists(/databases/(default)/documents/companies/main/staffInvitations/$(request.auth.token.email)) &&
        firestore.get(/databases/(default)/documents/companies/main/staffInvitations/$(request.auth.token.email)).data.status
          in ['invited', 'approved'];
    }
    function canUploadApplicant(uid) {
      return institutionalApplicant(uid) &&
        firestore.get(/databases/(default)/documents/companies/main/staffInvitations/$(request.auth.token.email)).data.status == 'invited';
    }
    function hasDraft(uid) {
      return firestore.exists(/databases/(default)/documents/companies/main/accessRequests/$(uid)) &&
        firestore.get(/databases/(default)/documents/companies/main/accessRequests/$(uid)).data.status == 'draft';
    }

    match /companies/main/onboarding/{uid}/{fileName} {
      allow get: if isOwner() || institutionalApplicant(uid);
      allow list: if false;
      allow create: if canUploadApplicant(uid) && hasDraft(uid) &&
        request.resource != null && request.resource.size > 0 &&
        (
          (fileName.matches('photo-[0-9a-f-]+[.](jpg|png|webp)') &&
           request.resource.size <= 3 * 1024 * 1024 &&
           request.resource.contentType in ['image/jpeg','image/png','image/webp']) ||
          (fileName.matches('identity-[0-9a-f-]+[.](jpg|png|webp|pdf)') &&
           request.resource.size <= 8 * 1024 * 1024 &&
           request.resource.contentType in ['image/jpeg','image/png','image/webp','application/pdf'])
        );
      allow update: if false;
      allow delete: if isOwner();
    }

    // Cada usuario autorizado guarda sus archivos en su carpeta UID.
    // Este mismo patrón se usa en src/backend.ts.
    match /companies/main/documents/{ownerUid}/{fileName} {
      // Los administradores ven todos; el empleado o cliente solo los suyos.
      allow get: if isOwner() ||
        (canViewDocuments() && request.auth.uid == ownerUid);

      // Para evitar enumerar carpetas ajenas, solo los administradores listan.
      allow list: if isOwner();

      // No es posible subir archivos en la carpeta de otro usuario.
      allow create: if canViewDocuments() &&
        request.auth.uid == ownerUid &&
        supportedDocument() &&
        fileName.matches('.*[.](pdf|jpg|png|webp)') &&
        request.resource.metadata.uploaderUid == ownerUid;

      // Los archivos existentes no deben sobreescribirse.
      allow update: if false;

      // Eliminación centralizada, para mantener el control de expedientes.
      allow delete: if isOwner();
    }

    // Fotografías de perfil: 2 MB como máximo.
    match /companies/main/profilePhotos/{ownerUid}/{fileName} {
      allow get: if isOwner() ||
        (isActiveMember() && request.auth.uid == ownerUid);
      allow list: if isOwner();

      allow create: if (isOwner() || isActiveMember()) &&
        request.auth.uid == ownerUid &&
        request.resource != null &&
        request.resource.size > 0 &&
        request.resource.size <= 2 * 1024 * 1024 &&
        request.resource.contentType in [
          'image/jpeg', 'image/png', 'image/webp'
        ] &&
        fileName.matches('.*[.](jpg|png|webp)');

      allow update: if false;
      allow delete: if isOwner() ||
        (isActiveMember() && request.auth.uid == ownerUid);
    }


    function trialEnabled() {
      return firestore.exists(/databases/(default)/documents/companies/main/settings/enterpriseTrial) &&
        firestore.get(/databases/(default)/documents/companies/main/settings/enterpriseTrial).data.enabled == true;
    }
    function enterpriseRole(roles) {
      return isOwner() || (isActiveMember() &&
        (firestore.get(/databases/(default)/documents/companies/main/members/$(request.auth.uid)).data.role in roles ||
         firestore.get(/databases/(default)/documents/companies/main/members/$(request.auth.uid)).data.get('roles',[]).hasAny(roles)));
    }
    function enterpriseView(view) {
      return isOwner() || (isActiveMember() &&
        firestore.get(/databases/(default)/documents/companies/main/members/$(request.auth.uid)).data.get('allowedSections',[]).hasAny([view]));
    }
    function requestExists(id) {
      return firestore.exists(/databases/(default)/documents/companies/main/enterpriseIssuance/$(id));
    }
    function issuance(id) {
      return firestore.get(/databases/(default)/documents/companies/main/enterpriseIssuance/$(id)).data;
    }
    function enterpriseRead(id) {
      return verified() && trialEnabled() && requestExists(id) && enterpriseView('clientes') &&
         (enterpriseRole(['direccion','operaciones','servicio']) ||
          (enterpriseRole(['ventas']) && issuance(id).agentUid == request.auth.uid));
    }
    match /companies/main/enterpriseTrial/{requestId}/{fileName} {
      // Only synthetic files in this gated validation environment.
      allow get: if enterpriseRead(requestId);
      allow list: if false;
      allow create: if enterpriseRead(requestId) && enterpriseView('polizas') && supportedDocument() &&
        (
          (enterpriseRole(['ventas','direccion']) && issuance(requestId).agentUid == request.auth.uid &&
           issuance(requestId).status in ['DRAFT','NEEDS_CORRECTION'] &&
           fileName.matches('(front|back|registration)-[0-9a-f-]{36}[.](jpg|png|webp)') &&
           request.resource.contentType in ['image/jpeg','image/png','image/webp']) ||
          (enterpriseRole(['direccion','operaciones']) && issuance(requestId).operatorUid == request.auth.uid &&
           issuance(requestId).status == 'IN_REVIEW' && fileName.matches('policy-[0-9a-f-]{36}[.]pdf') &&
           request.resource.contentType == 'application/pdf')
        );
      allow update, delete: if false;
    }

    // Todo lo demás queda privado.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
