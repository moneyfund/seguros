rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Los administradores iniciales deben iniciar sesion con
    // Firebase Authentication (Google) y correo verificado.
    function verified() {
      return request.auth != null &&
        request.auth.token.email_verified == true;
    }

    // The corporate domain is configured only after ownership is verified.
    // Create companies/main/settings/staffIdentity = {domain: 'verified-company-domain'}.
    function staffDomainPath() {
      return /databases/$(database)/documents/companies/main/settings/staffIdentity;
    }
    // Invitation-first onboarding: corporate email domain is NOT required to start.
    // A verified, preinvited email can request access but cannot assign itself privileges.
    function staffInvitationPath() {
      return /databases/$(database)/documents/companies/main/staffInvitations/$(request.auth.token.email);
    }
    function isInvitedStaffUser() {
      return verified() &&
        exists(staffInvitationPath()) &&
        get(staffInvitationPath()).data.status == 'invited';
    }
    function isInstitutionalUser() {
      return isInvitedStaffUser();
    }

    function isOwner() {
      return verified() &&
        request.auth.token.email in [
          'norvingarcia220@gmail.com',
          'amyblandon171@gmail.com'
        ];
    }

    function memberPath() {
      return /databases/$(database)/documents/companies/main/members/$(request.auth.uid);
    }

    function isActiveMember() {
      return verified() &&
        exists(memberPath()) &&
        get(memberPath()).data.active == true;
    }

    function hasRole(allowed) {
      return isOwner() ||
        (isActiveMember() && (
          get(memberPath()).data.role in allowed ||
          get(memberPath()).data.get('roles', []).hasAny(allowed)
        ));
    }

    // Menus are not a security boundary: enforce approved views alongside roles.
    function hasView(viewKey) {
      return isOwner() ||
        (isActiveMember() &&
          get(memberPath()).data.get('allowedSections', []).hasAny([viewKey]));
    }

    function isClient() {
      return isActiveMember() &&
        get(memberPath()).data.role == 'cliente';
    }

    function changedOnly(allowedFields) {
      return request.resource.data.diff(resource.data)
        .affectedKeys().hasOnly(allowedFields);
    }

    // SOLO la empresa 'main' (modelo de esta primera version).
    match /companies/main {
      allow read, write: if false;

      // Cuentas internas. Los usuarios no pueden darse privilegios.
      match /members/{memberUid} {
        allow get: if isOwner() ||
          (verified() && request.auth.uid == memberUid) ||
          (hasRole(['supervision']) && hasView('equipo'));
        allow list: if isOwner() || (hasRole(['supervision']) && hasView('equipo'));

        allow create: if isOwner() &&
          request.resource.data.keys().hasAll(
            ['email','displayName','role','active','approvedAt']
          ) &&
          request.resource.data.role in [
            'direccion','ventas','operaciones','servicio',
            'finanzas','supervision','cliente'
          ] &&
          request.resource.data.active is bool &&
          request.resource.data.get('roles', []) is list &&
          request.resource.data.get('roles', []).hasOnly([
            'direccion','ventas','operaciones','servicio','finanzas','supervision','cliente'
          ]) &&
          request.resource.data.get('allowedSections', []) is list &&
          request.resource.data.get('allowedSections', []).hasOnly([
            'resumen','prospectos','polizas','clientes','solicitudes','finanzas','equipo','documentos','configuracion'
          ]);

        allow update, delete: if isOwner();
      }

      // Invitations are created by direction, not by applicants. Each employee
      // can only read the invitation for their *verified* Firebase email address.
      match /staffInvitations/{email} {
        allow get: if isOwner() ||
          (verified() && request.auth.token.email == email);
        allow list: if isOwner();
        allow create: if isOwner() &&
          request.resource.data.email == email &&
          request.resource.data.status == 'invited' &&
          request.resource.data.createdBy == request.auth.uid &&
          request.resource.data.requestedDepartment in [
            'direccion','ventas','operaciones','servicio','finanzas','supervision'
          ];
        allow update, delete: if isOwner();
      }

      // Institutional onboarding. A draft is created before uploading its two private files.
      match /accessRequests/{uid} {
        allow get: if isOwner() || (verified() && request.auth.uid == uid);
        allow list: if isOwner();

        allow create: if isInstitutionalUser() &&
          request.auth.uid == uid &&
          request.resource.data.keys().hasOnly([
            'email','displayName','phone','requestedDepartment','requestedRole','status','requestedAt'
          ]) &&
          request.resource.data.keys().hasAll([
            'email','displayName','phone','requestedDepartment','requestedRole','status','requestedAt'
          ]) &&
          request.resource.data.email == request.auth.token.email &&
          request.resource.data.displayName is string &&
          request.resource.data.displayName.size() >= 3 &&
          request.resource.data.displayName.size() <= 90 &&
          request.resource.data.phone is string &&
          request.resource.data.phone.matches('[+]?[0-9 ()-]{8,20}') &&
          request.resource.data.requestedDepartment in [
            'direccion','ventas','operaciones','servicio','finanzas','supervision'
          ] &&
          request.resource.data.requestedRole == request.resource.data.requestedDepartment &&
          request.resource.data.status == 'draft' &&
          request.resource.data.requestedAt is timestamp;

        allow update: if
          (isInstitutionalUser() &&
           request.auth.uid == uid &&
           resource.data.status == 'draft' &&
           (
             (request.resource.data.status == 'draft' &&
              changedOnly(['displayName','phone','requestedDepartment','requestedRole']) &&
              request.resource.data.email == request.auth.token.email &&
              request.resource.data.displayName is string &&
              request.resource.data.displayName.size() >= 3 &&
              request.resource.data.displayName.size() <= 90 &&
              request.resource.data.phone is string &&
              request.resource.data.phone.matches('[+]?[0-9 ()-]{8,20}') &&
              request.resource.data.requestedDepartment in [
                'direccion','ventas','operaciones','servicio','finanzas','supervision'
              ] &&
              request.resource.data.requestedRole == request.resource.data.requestedDepartment)
             ||
             (request.resource.data.status == 'pending' &&
              changedOnly(['status','profilePhotoPath','identityDocumentPath','submittedAt']) &&
              request.resource.data.profilePhotoPath.matches(
                'companies/main/onboarding/' + uid + '/photo-.*[.](jpg|png|webp)'
              ) &&
              request.resource.data.identityDocumentPath.matches(
                'companies/main/onboarding/' + uid + '/identity-.*[.](pdf|jpg|png|webp)'
              ) &&
              request.resource.data.submittedAt is timestamp)
           )) ||
          (isOwner() &&
           resource.data.status == 'pending' &&
           changedOnly([
             'status','reviewedAt','approvedDepartment','employeeCode','notificationStatus'
           ]) &&
           request.resource.data.status in ['approved','rejected']);

        allow delete: if isOwner();
      }

      // Only privileged server-side code may eventually mark notifications as sent.
      // No client can send arbitrary email from ACOS.
      // Oportunidades comerciales: agentes, supervisores y gerencia.
      match /leads/{leadId} {
        allow read: if hasView('prospectos') && (isOwner() ||
          hasRole(['direccion','supervision']) ||
          (hasRole(['ventas']) &&
           resource.data.assignedToUid == request.auth.uid));

        allow create: if hasView('prospectos') &&
          hasRole(['direccion','supervision','ventas']) &&
          request.resource.data.keys().hasAll([
            'name','product','estimatedPremium','status','channel',
            'assignedToUid','assignedToName','createdBy','createdAt'
          ]) &&
          request.resource.data.createdBy == request.auth.uid &&
          request.resource.data.assignedToUid == request.auth.uid &&
          request.resource.data.status == 'Nuevo' &&
          request.resource.data.name is string &&
          request.resource.data.name.size() > 1 &&
          request.resource.data.name.size() <= 120 &&
          request.resource.data.estimatedPremium >= 0 &&
          request.resource.data.createdAt is timestamp;

        allow update: if hasView('prospectos') && (isOwner() ||
          hasRole(['direccion','supervision']) ||
          (hasRole(['ventas']) &&
           resource.data.assignedToUid == request.auth.uid)) &&
          changedOnly(['status','updatedAt']) &&
          request.resource.data.status in [
            'Nuevo','Contactado','Cotización','Negociación','Ganado'
          ];

        allow delete: if isOwner();
      }

      // Expedientes de polizas: cliente solo sus propias polizas
      // con clientUid = su UID autenticado.
      match /policies/{policyId} {
        allow read: if hasView('polizas') && (
          hasRole(['direccion','operaciones','servicio','finanzas','supervision']) ||
          (hasRole(['ventas']) && resource.data.assignedToUid == request.auth.uid) ||
          (isClient() && resource.data.clientUid == request.auth.uid));

        allow create: if hasView('polizas') && hasRole(['direccion','operaciones']) &&
          request.resource.data.keys().hasAll([
            'clientName','insurer','product','premium',
            'status','clientUid','createdBy','createdAt'
          ]) &&
          request.resource.data.createdBy == request.auth.uid &&
          request.resource.data.clientUid == '' &&
          request.resource.data.status == 'En gestión' &&
          request.resource.data.clientName is string &&
          request.resource.data.clientName.size() > 1 &&
          request.resource.data.premium >= 0 &&
          request.resource.data.createdAt is timestamp;

        allow update: if hasView('polizas') && (isOwner() ||
          (hasRole(['direccion','operaciones']) &&
           changedOnly(['status','updatedAt'])));

        allow delete: if isOwner();
      }

      // Casos de servicio y solicitudes del asegurado.
      match /tickets/{ticketId} {
        allow read: if hasView('solicitudes') && (
          hasRole(['direccion','operaciones','servicio','supervision']) ||
          (isClient() && resource.data.clientUid == request.auth.uid));

        allow create: if hasView('solicitudes') &&
          hasRole(['direccion','operaciones','servicio','supervision','cliente']) &&
          request.resource.data.keys().hasAll([
            'subject','detail','type','status','priority',
            'clientUid','createdBy','createdAt'
          ]) &&
          request.resource.data.createdBy == request.auth.uid &&
          request.resource.data.status == 'Pendiente' &&
          request.resource.data.priority == 'Media' &&
          request.resource.data.subject is string &&
          request.resource.data.subject.size() >= 2 &&
          request.resource.data.subject.size() <= 130 &&
          request.resource.data.detail is string &&
          request.resource.data.detail.size() <= 2000 &&
          request.resource.data.createdAt is timestamp &&
          (
            (isClient() &&
             request.resource.data.clientUid == request.auth.uid) ||
            (!isClient() && request.resource.data.clientUid == '')
          );

        allow update: if hasView('solicitudes') &&
          hasRole(['direccion','operaciones','servicio']) &&
          changedOnly(['status','updatedAt']) &&
          request.resource.data.status == 'Resuelto';

        allow delete: if isOwner();
      }

      // Liquidaciones: lectura restringida a finanzas y direccion.
      // Hasta definir conciliacion, solo propietarios pueden escribir.
      match /commissions/{commissionId} {
        allow read: if hasView('finanzas') && (hasRole(['direccion','finanzas']) ||
          (hasRole(['ventas']) && resource.data.agentUid == request.auth.uid));
        allow create, update, delete: if isOwner();
      }

      // Metadatos documentales. El empleado solo ve sus propios
      // archivos; el cliente solo los que estan asociados a su UID.
      match /documents/{documentId} {
        allow read: if hasView('documentos') && (
          isOwner() ||
          (isActiveMember() && resource.data.uploaderUid == request.auth.uid) ||
          (isClient() && resource.data.clientUid == request.auth.uid));

        allow create: if hasView('documentos') &&
          hasRole(['direccion','ventas','operaciones','servicio','finanzas','supervision','cliente']) &&
          request.resource.data.keys().hasAll([
            'fileName','contentType','bytes','storagePath',
            'uploaderUid','clientUid','createdAt'
          ]) &&
          request.resource.data.uploaderUid == request.auth.uid &&
          request.resource.data.storagePath is string &&
          request.resource.data.storagePath.matches(
            'companies/main/documents/' + request.auth.uid + '/.*'
          ) &&
          request.resource.data.contentType in [
            'application/pdf','image/jpeg','image/png','image/webp'
          ] &&
          request.resource.data.bytes > 0 &&
          request.resource.data.bytes <= 8388608 &&
          request.resource.data.createdAt is timestamp &&
          (
            (isClient() &&
             request.resource.data.clientUid == request.auth.uid) ||
            (!isClient() && request.resource.data.clientUid == '')
          );

        allow update: if false;
        allow delete: if isOwner();
      }


      // Isolated enterprise validation workflow. Disabled unless the owner
      // explicitly sets settings/enterpriseTrial.enabled=true in a test project.
      // Synthetic records ONLY until trusted SQL/Storage backend and QA are approved.
      function trialEnabled() {
        return get(/databases/$(database)/documents/companies/main/settings/enterpriseTrial).data.enabled == true;
      }
      function enterpriseWide() {
        return hasView('clientes') && hasRole(['direccion','operaciones','servicio']);
      }
      function enterpriseSales() {
        return hasView('clientes') && hasRole(['ventas','direccion']);
      }
      function enterpriseOperator() {
        return hasView('clientes') && hasView('polizas') && hasRole(['direccion','operaciones']);
      }
      function enterpriseAgent(uid) {
        return verified() && request.auth.uid == uid && enterpriseSales();
      }
      function validString(v, min, max) {
        return v is string && v.size() >= min && v.size() <= max;
      }
      function enterpriseCustomerPath(id) {
        return /databases/$(database)/documents/companies/main/enterpriseClients/$(id);
      }
      function validProfile(p) {
        return p is map && p.keys().hasOnly(['documentType','documentNumber','birthDate','nationality','occupation','department','address','alternatePhone']) &&
          p.keys().hasAll(['documentType','documentNumber','birthDate','nationality','occupation','department','address','alternatePhone']) &&
          p.documentType in ['CEDULA','PASAPORTE','RESIDENCIA','RUC','OTRO'] &&
          validString(p.documentNumber,0,40) && validString(p.birthDate,0,10) &&
          (p.birthDate == '' || p.birthDate.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')) &&
          validString(p.nationality,0,60) && validString(p.occupation,0,100) &&
          validString(p.department,0,80) && validString(p.address,0,240) &&
          validString(p.alternatePhone,0,32);
      }
      function validVehicle(v) {
        return v is map && v.keys().hasOnly(['make','model','year','color','vin','use']) &&
          v.keys().hasAll(['make','model','year','color','vin','use']) &&
          validString(v.make,0,60) && validString(v.model,0,80) &&
          validString(v.year,0,4) && (v.year == '' || v.year.matches('[0-9]{4}')) &&
          validString(v.color,0,40) && validString(v.vin,0,40) &&
          v.use in ['Particular','Comercial','Taxi','Motocicleta','Otro'];
      }
      function validCustomer(d) {
        return d.keys().hasOnly(['fullName','email','phone','city','ownerUid','createdAt','trial','profile']) && (!d.keys().hasAny(['profile']) || validProfile(d.profile)) &&
          d.keys().hasAll(['fullName','email','phone','city','ownerUid','createdAt','trial']) &&
          validString(d.fullName, 2, 120) && validString(d.email, 0, 150) &&
          (d.email == '' || d.email.matches('[^@ ]+@[^@ ]+[.][^@ ]+')) &&
          validString(d.phone, 0, 32) && validString(d.city, 0, 100) &&
          assignedSales(d.ownerUid,['clientes']) && d.createdAt == request.time && d.trial == true;
      }
      function eligibleSales(uid, views) {
        let m = get(/databases/$(database)/documents/companies/main/members/$(uid)).data;
        return m.active == true && (m.role in ['ventas','direccion'] || m.get('roles',[]).hasAny(['ventas','direccion'])) &&
          m.get('allowedSections',[]).hasAll(views);
      }
      function assignedOtherSales(uid) {
        let m = get(/databases/$(database)/documents/companies/main/members/$(uid)).data;
        return m.active == true && (m.role == 'ventas' || m.get('roles',[]).hasAny(['ventas']));
      }
      function assignedSales(uid, views) {
        return verified() && (isOwner()
          ? uid == request.auth.uid || assignedOtherSales(uid)
          : uid == request.auth.uid && eligibleSales(uid, views));
      }
      function correctionMetadata(d) {
        return d.adminUpdatedBy == request.auth.uid && d.adminUpdatedAt == request.time &&
          validString(d.adminReason,3,500);
      }
      function customerFields(d) {
        return validString(d.fullName,2,120) && validString(d.email,0,150) &&
          (d.email == '' || d.email.matches('[^@ ]+@[^@ ]+[.][^@ ]+')) &&
          validString(d.phone,0,32) && validString(d.city,0,100) &&
          (!d.keys().hasAny(['profile']) || validProfile(d.profile));
      }
      // Dedicated owner-only trash. Copy and removal must be one atomic operation.
      function recordPath(kind,id) {
        return /databases/$(database)/documents/companies/main/$(kind)/$(id);
      }
      function validTrashEnvelope(d, original) {
        return d.keys().hasOnly(['record','movedAt','movedBy','reason','purging']) &&
          d.keys().hasAll(['record','movedAt','movedBy','reason','purging']) &&
          d.record == original && d.movedAt == request.time &&
          d.movedBy == request.auth.uid && validString(d.reason,3,500) && d.purging == false;
      }
      function canMoveToTrash(trashKind,id) {
        let target = recordPath(trashKind,id);
        return isOwner() && trialEnabled() && !exists(target) &&
          existsAfter(target) && validTrashEnvelope(getAfter(target).data,resource.data);
      }
      function sameRestoredRecord(saved, restored) {
        return restored.get('archived',true) == false &&
          restored.diff(saved).affectedKeys().hasOnly(['archived']);
      }
      function activeTrashCustomer(id) {
        let target = enterpriseCustomerPath(id);
        return existsAfter(target) && getAfter(target).data.get('archived',false) == false;
      }
      function canRestore(trashKind,id) {
        let target = recordPath(trashKind,id);
        return isOwner() && trialEnabled() && exists(target) && !existsAfter(target) &&
          get(target).data.purging == false &&
          sameRestoredRecord(get(target).data.record,request.resource.data);
      }
      function trashSource(kind) {
        return kind == 'enterpriseTrashClients' ? 'enterpriseClients' : 'enterpriseIssuance';
      }
      match /{trashKind}/{id} {
        function isTrash() { return trashKind in ['enterpriseTrashClients','enterpriseTrashIssuance']; }
        function originalPath() { return recordPath(trashSource(trashKind),id); }
        allow read: if isTrash() && isOwner();
        allow create: if isTrash() && isOwner() && trialEnabled() &&
          exists(originalPath()) && !existsAfter(originalPath()) &&
          validTrashEnvelope(request.resource.data,get(originalPath()).data);
        allow update: if isTrash() && isOwner() && trialEnabled() && resource.data.purging == false &&
          request.resource.data.purging == true && changedOnly(['purging']) && !existsAfter(originalPath());
        allow delete: if isTrash() && isOwner() && trialEnabled() &&
          (resource.data.purging == true && !existsAfter(originalPath()) ||
           resource.data.purging == false && existsAfter(originalPath()) &&
           sameRestoredRecord(resource.data.record,getAfter(originalPath()).data));
      }
      match /enterpriseAdminAudit/{auditId} {
        allow read: if isOwner();
        allow create: if isOwner() && request.resource.data.keys().hasOnly(['targetType','targetId','action','reason','actorUid','createdAt']) &&
          request.resource.data.keys().hasAll(['targetType','targetId','action','reason','actorUid','createdAt']) &&
          request.resource.data.targetType in ['enterpriseClients','enterpriseIssuance'] &&
          validString(request.resource.data.targetId,1,100) &&
          request.resource.data.action in ['EDIT_CLIENT','EDIT_POLICY','ARCHIVE','RESTORE','DELETE_ATTACHMENT','PURGE'] &&
          validString(request.resource.data.reason,3,500) && request.resource.data.actorUid == request.auth.uid &&
          request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
      match /settings/enterpriseTrial {
        allow get: if hasView('clientes') && hasRole(['direccion','ventas','operaciones','servicio']);
        // Broader existing settings rule gives owners management.
      }
      match /enterpriseClients/{clientId} {
        allow read: if trialEnabled() && (enterpriseWide() || enterpriseAgent(resource.data.ownerUid));
        allow create: if canRestore('enterpriseTrashClients',clientId) || trialEnabled() && !exists(recordPath('enterpriseTrashClients',clientId)) && validCustomer(request.resource.data);
        allow update: if trialEnabled() && isOwner() && correctionMetadata(request.resource.data) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fullName','email','phone','city','profile','archived','adminUpdatedAt','adminUpdatedBy','adminReason']) &&
          customerFields(request.resource.data) && request.resource.data.get('archived',false) is bool;
        allow delete: if canMoveToTrash('enterpriseTrashClients',clientId);
      }
      function validAttachment(name, kind) {
        return name is string && (name == '' ||
          name.matches(kind + '-[0-9a-f-]{36}[.](jpg|png|webp)'));
      }
      function validAttachments(d) {
        return d.files is map && d.files.keys().hasOnly(['front','back','registration']) &&
          d.files.keys().hasAll(['front','back','registration']) &&
          validAttachment(d.files.front,'front') && validAttachment(d.files.back,'back') &&
          validAttachment(d.files.registration,'registration');
      }
      function completeAttachments(d) {
        return validAttachments(d) && d.files.front != '' && d.files.back != '' && d.files.registration != '';
      }
      function validDraft(d) {
        return d.keys().hasAll(['clientId','clientName','agentUid','insurerId','productKey','plate','status','files','pdf','policyNumber','startDate','endDate','premiumCents','currency','operatorUid','reason','revision','agentSeenRevision','createdAt','updatedAt','trial']) &&
          d.keys().hasOnly(['clientId','clientName','agentUid','insurerId','productKey','plate','status','files','pdf','policyNumber','startDate','endDate','premiumCents','currency','operatorUid','reason','revision','agentSeenRevision','createdAt','updatedAt','trial','vehicle']) && (!d.keys().hasAny(['vehicle']) || validVehicle(d.vehicle)) &&
          validString(d.clientId,1,80) && activeTrashCustomer(d.clientId) &&
          getAfter(enterpriseCustomerPath(d.clientId)).data.ownerUid == request.auth.uid &&
          getAfter(enterpriseCustomerPath(d.clientId)).data.fullName == d.clientName &&
          d.agentUid == request.auth.uid && d.insurerId in ['iniser','assa','america','lafise','mapfre'] &&
          d.productKey == 'VEHICLE_MANDATORY' && validString(d.plate,1,24) && d.status == 'DRAFT' &&
          validAttachments(d) && d.files.front == '' && d.files.back == '' && d.files.registration == '' &&
          d.pdf == '' && d.policyNumber == '' && d.startDate == '' && d.endDate == '' &&
          d.premiumCents == 0 && d.currency == 'USD' && d.operatorUid == '' && d.reason == '' &&
          d.revision == 0 && d.agentSeenRevision == 0 && d.createdAt == request.time &&
          d.updatedAt == request.time && d.trial == true;
      }
      function nextRevision() {
        return request.resource.data.revision == resource.data.revision + 1 &&
          request.resource.data.updatedAt == request.time;
      }
      function validIssued(d) {
        return d.pdf is string && d.pdf.matches('policy-[0-9a-f-]{36}[.]pdf') &&
          validString(d.policyNumber,1,100) &&
          d.startDate is string && d.startDate.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}') &&
          d.endDate is string && d.endDate.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}') &&
          d.endDate >= d.startDate && d.premiumCents is int && d.premiumCents >= 0 &&
          d.premiumCents <= 1000000000 && d.currency in ['USD','NIO'];
      }
      function validPolicyFields(d) {
        return d.insurerId in ['iniser','assa','america','lafise','mapfre'] &&
          validString(d.plate,1,24) && validVehicle(d.vehicle) &&
          validString(d.policyNumber,1,100) &&
          d.startDate is string && d.startDate.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}') &&
          d.endDate is string && d.endDate.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}') &&
          d.endDate >= d.startDate && d.premiumCents is int && d.premiumCents >= 0 &&
          d.premiumCents <= 1000000000 && d.currency in ['USD','NIO'];
      }
      function externalRecord(d) {
        let c = getAfter(enterpriseCustomerPath(d.clientId)).data;
        return d.keys().hasOnly(['clientId','clientName','agentUid','insurerId','productKey','plate','vehicle','status','files','pdf','policyNumber','startDate','endDate','premiumCents','currency','operatorUid','reason','revision','agentSeenRevision','createdAt','updatedAt','trial','source','registeredBy']) &&
          d.source == 'EXTERNAL' && d.registeredBy == request.auth.uid && d.status == 'ISSUED' &&
          validString(d.clientId,1,80) && c.ownerUid == d.agentUid &&
          c.get('archived',false) == false && c.fullName == d.clientName &&
          assignedSales(d.agentUid,['clientes','polizas']) && d.productKey == 'VEHICLE_MANDATORY' && validPolicyFields(d) &&
          validAttachments(d) && d.files.front == '' && d.files.back == '' && d.files.registration == '' &&
          d.pdf == '' && d.operatorUid == '' && d.reason == '' && d.revision == 0 && d.agentSeenRevision == 0 &&
          d.createdAt == request.time && d.updatedAt == request.time && d.trial == true;
      }
      function appendExternal(old,next,keys) {
        return old.get('source','') == 'EXTERNAL' && old.get('archived',false) == false &&
          old.status == 'ISSUED' && next.updatedAt == request.time && hasView('polizas') &&
          (isOwner() || enterpriseAgent(old.agentUid)) &&
          (keys.hasOnly(['files','updatedAt']) && validAttachments(next) &&
            (old.files.front == '' || old.files.front == next.files.front) &&
            (old.files.back == '' || old.files.back == next.files.back) &&
            (old.files.registration == '' || old.files.registration == next.files.registration) ||
           keys.hasOnly(['pdf','updatedAt']) && old.pdf == '' && next.pdf.matches('policy-[0-9a-f-]{36}[.]pdf'));
      }
      function adminPolicyChange(old,next,keys) {
        return isOwner() && correctionMetadata(next) &&
          keys.hasOnly(['insurerId','plate','vehicle','policyNumber','startDate','endDate','premiumCents','currency','files','pdf','archived','updatedAt','adminUpdatedAt','adminUpdatedBy','adminReason']) &&
          next.get('archived',false) is bool &&
          (!keys.hasAny(['insurerId','plate','vehicle','policyNumber','startDate','endDate','premiumCents','currency']) ||
            old.status == 'ISSUED' && validPolicyFields(next)) &&
          validAttachments(next) &&
          (next.files.front == old.files.front || next.files.front == '') &&
          (next.files.back == old.files.back || next.files.back == '') &&
          (next.files.registration == old.files.registration || next.files.registration == '') &&
          (next.pdf == old.pdf || next.pdf == '') &&
          (!keys.hasAny(['updatedAt']) || next.updatedAt == request.time);
      }
      match /enterpriseIssuance/{requestId} {
        allow read: if trialEnabled() && (enterpriseWide() || enterpriseAgent(resource.data.agentUid));
        allow create: if (canRestore('enterpriseTrashIssuance',requestId) && activeTrashCustomer(request.resource.data.clientId)) || trialEnabled() && !exists(recordPath('enterpriseTrashIssuance',requestId)) &&
          (request.resource.data.get('source','') == 'EXTERNAL' ? externalRecord(request.resource.data) : enterpriseSales() && hasView('polizas') && validDraft(request.resource.data));
        // Evaluate only the relevant action. Avoid exceeding the Rules engine's
        // 1,000-expression budget by repeatedly expanding authorization helpers.
        function agentEdit(old, next, keys) {
          return old.status in ['DRAFT','NEEDS_CORRECTION'] &&
            (next.status == old.status
              ? keys.hasOnly(['files','updatedAt']) && validAttachments(next) && next.updatedAt == request.time &&
                (old.files.front == '' || old.files.front == next.files.front) &&
                (old.files.back == '' || old.files.back == next.files.back) &&
                (old.files.registration == '' || old.files.registration == next.files.registration)
              : next.status == 'SUBMITTED' && keys.hasOnly(['status','operatorUid','reason','revision','updatedAt']) &&
                next.operatorUid == '' && next.reason == '' && completeAttachments(old) && nextRevision()) &&
            hasView('polizas') && enterpriseAgent(old.agentUid);
        }
        function operatorEdit(old, next, keys) {
          return nextRevision() &&
            (old.status == 'SUBMITTED'
              ? next.status == 'IN_REVIEW' && keys.hasOnly(['status','operatorUid','revision','updatedAt']) &&
                next.operatorUid == request.auth.uid
              : old.status == 'IN_REVIEW' && old.operatorUid == request.auth.uid &&
                (next.status == 'ISSUED'
                  ? keys.hasOnly(['status','pdf','policyNumber','startDate','endDate','premiumCents','currency','revision','updatedAt']) && validIssued(next)
                  : next.status in ['NEEDS_CORRECTION','REJECTED'] &&
                    keys.hasOnly(['status','reason','revision','updatedAt']) && validString(next.reason,2,1000))) &&
            enterpriseOperator();
        }
        function authorizedChange() {
          let old = resource.data;
          let next = request.resource.data;
          let keys = next.diff(old).affectedKeys();
          return keys.hasAny(['adminUpdatedAt','adminUpdatedBy','adminReason']) ? adminPolicyChange(old,next,keys) :
            old.get('source','') == 'EXTERNAL' ? appendExternal(old,next,keys) :
            old.get('archived',false) == true ? false :
            keys.hasOnly(['agentSeenRevision'])
            ? next.agentSeenRevision == old.revision && enterpriseAgent(old.agentUid)
            : old.status in ['DRAFT','NEEDS_CORRECTION']
              ? agentEdit(old,next,keys)
              : operatorEdit(old,next,keys);
        }
        allow update: if verified() && trialEnabled() && authorizedChange();
        allow delete: if canMoveToTrash('enterpriseTrashIssuance',requestId);
      }

      // Colecciones en reserva. Solo gerencia, hasta definir alcance.
      match /clients/{clientId} {
        allow read: if hasRole(['direccion']) && hasView('clientes');
        allow write: if isOwner();
      }

      match /insurers/{insurerId} {
        allow read: if hasView('polizas') && hasRole([
          'direccion','ventas','operaciones','servicio','finanzas','supervision'
        ]);
        allow write: if isOwner();
      }

      match /settings/{settingId} {
        allow read, write: if isOwner();
      }

      // Dedicated fictitious-data laboratory, readable and writable ONLY by verified owners.
      // These collections never authorize normal employees and never alter live CRM records.
      match /{pilotCollection}/{pilotRecordId} {
        allow read: if pilotCollection in [
          'pilotClients','pilotLeads','pilotPolicies','pilotTickets',
          'pilotCommissions','pilotDocuments','pilotActivities','pilotMeta'
        ] && isOwner();
        allow create, update: if pilotCollection in [
          'pilotClients','pilotLeads','pilotPolicies','pilotTickets',
          'pilotCommissions','pilotDocuments','pilotActivities','pilotMeta'
        ] && isOwner() && request.resource.data.isPilot == true;
        allow delete: if pilotCollection in [
          'pilotClients','pilotLeads','pilotPolicies','pilotTickets',
          'pilotCommissions','pilotDocuments','pilotActivities','pilotMeta'
        ] && isOwner();
      }

      // ACOS Mail: append-only supervision records. No mailbox credentials or content.
      match /academyVideos/{videoId} {
        allow read: if true;
        function validLesson(d) {
          return d.keys().hasAll(['title','description','videoId','author','track','createdAt','updatedAt']) &&
            d.keys().hasOnly(['title','description','videoId','author','track','createdAt','updatedAt']) &&
            validString(d.title,3,120) && validString(d.description,1,500) &&
            validString(d.author,2,100) && d.videoId is string &&
            d.videoId.matches('[A-Za-z0-9_-]{11}') &&
            d.track in ['finanzas','seguros','proteccion'] && d.updatedAt == request.time;
        }
        allow create: if isOwner() && validLesson(request.resource.data) && request.resource.data.createdAt == request.time;
        allow update: if isOwner() && validLesson(request.resource.data) && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isOwner();
      }

      match /mailAudit/{auditId} {
        allow get, list: if isOwner();
        allow create: if isOwner() &&
          request.resource.data.keys().hasOnly(['actorUid','mailboxId','department','action','folder','messageUid','reason','createdAt']) &&
          request.resource.data.keys().hasAll(['actorUid','mailboxId','department','action','folder','messageUid','reason','createdAt']) &&
          request.resource.data.actorUid == request.auth.uid &&
          request.resource.data.mailboxId is string &&
          request.resource.data.mailboxId.matches('[A-Za-z0-9_-]{1,128}') &&
          request.resource.data.department in ['direccion','ventas','operaciones','servicio','finanzas','supervision'] &&
          request.resource.data.action in ['list','read','attachment'] &&
          request.resource.data.folder in ['inbox','sent','drafts','archive','trash','spam'] &&
          request.resource.data.messageUid is string &&
          request.resource.data.messageUid.size() <= 10 &&
          request.resource.data.reason is string &&
          request.resource.data.reason.size() >= 8 &&
          request.resource.data.reason.size() <= 250 &&
          request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }

      match /auditLogs/{auditId} {
        allow read: if isOwner();
        allow write: if false;
      }
    }

    // Todo lo no autorizado arriba permanece privado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
